# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/finance

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=your-very-long-random-secret-key-here
PORT=3000

# ── Encryption (AES-256-GCM) ──────────────────────────────
# برای تولید: openssl rand -hex 32
# اگر خالی بگذارید، داده‌ها رمزنگاری نمی‌شوند
ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────
# مثال: https://my-app.onrender.com
# اگر خالی بگذارید، همه origin ها مجاز هستند (فقط برای dev)
ALLOWED_ORIGIN=

# ── Redis Cache (اختیاری) ─────────────────────────────────
# اگر خالی بگذارید، از in-memory cache استفاده می‌شود
REDIS_URL=
